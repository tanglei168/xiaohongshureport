# 基础配置
XHS_REPORT_ENVIRONMENT=development
XHS_REPORT_LOG_LEVEL=INFO
XHS_REPORT_DATABASE_PATH=.data/xhs_report.db
XHS_REPORT_BROWSER_PROFILE_PATH=.data/xhs-profile
XHS_REPORT_BROWSER_STORAGE_STATE_PATH=.data/xhs-storage-state.json
XHS_REPORT_REPORTS_PATH=reports
XHS_REPORT_DEBUG_PATH=.debug

# 采集限速与滚动停止条件
XHS_REPORT_DETAIL_DELAY_MIN_SECONDS=1.5
XHS_REPORT_DETAIL_DELAY_MAX_SECONDS=3.0
XHS_REPORT_SCROLL_DELAY_SECONDS=1.2
XHS_REPORT_STABLE_SCROLL_ROUNDS=4
XHS_REPORT_LOGIN_TIMEOUT_SECONDS=300

# 飞书开放平台；只在本地 .env 中填写真实值
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_ACCOUNT_TABLE_ID=
FEISHU_NOTE_TABLE_ID=
FEISHU_REPORT_TABLE_ID=
FEISHU_RUN_TABLE_ID=
